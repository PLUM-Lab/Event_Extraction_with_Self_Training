{
  "bert_model_name": "roberta_large",
  "bert_cache_dir": "bert_cache",
  "multi_piece_strategy": "average",
  "bert_dropout": 0.5,
  "use_extra_bert": true,
  "extra_bert": -3,

  "use_global_features": true,
  "global_features": [],
  "global_warmup": 0,

  "linear_dropout": 0.4,
  "linear_bias": true,
  "entity_hidden_num": 150,
  "mention_hidden_num": 150,
  "event_hidden_num": 600,
  "relation_hidden_num": 150,
  "role_hidden_num": 600,
  "use_entity_type": true,
  "beam_size": 10,
  "beta_v": 2,
  "beta_e": 2,
  "relation_mask_self": true,
  "relation_directional": false,
  "symmetric_relations": ["PER-SOC"],

  "train_file": "dataset/ACE05/bert_large_cased/oneie/train.oneie.json",
  "dev_file": "dataset/ACE05/bert_large_cased/oneie/dev.oneie.json",
  "test_file": "dataset/ACE05/bert_large_cased/oneie/test.oneie.json",
  "log_path": "experiment",
  "valid_pattern_path": "resource/valid_patterns",
  "ignore_title": true,
  "ignore_first_header": false,


  "load_model_path": "checkpoints/english.role.v0.3.mdl",
  "score_model_path": "experiment/seq_score/exp1/best.role.mdl",
  "aux_train_file": "YOUR_PROJECT_PATH/dataset/aligned_amr3.0/aux_amr3.0.jsonl",
  "min_amr_length": 15,
  "test_beam_size": 10,
  "aux2train_ratio": 1,
  "mix_ratio": 1.0,
  "feedback": true,
  "further_train": false,
  "optimizer": "sgd",


  "accumulate_step": 1,
  "batch_size": 10,
  "eval_batch_size": 16,
  "max_epoch": 60,
  "learning_rate": 0.0005,
  "bert_learning_rate": 0.0001,
  "weight_decay": 5e-5,
  "bert_weight_decay": 1e-5,
  "warmup_epoch": 5,
  "grad_clipping": 5.0,

  "use_gpu": true,
  "gpu_device": 0
}

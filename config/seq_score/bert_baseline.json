{
    "bert_model_name": "bert-large-cased",
    "bert_cache_dir": "./",
    "multi_piece_strategy": "average",
    "bert_dropout": 0.5,
    "use_extra_bert": true,
    "extra_bert": -3,
  
    "use_global_features": true,
    "global_features": [],
    "global_warmup": 0,
  
    "linear_dropout": 0.4,
    "linear_bias": true,
    "entity_hidden_num": 150,
    "mention_hidden_num": 150,
    "event_hidden_num": 600,
    "relation_hidden_num": 150,
    "role_hidden_num": 600,
    "edge_type_dim": 256,
    "gnn_layers": 2,
    "beam_size": 20,
    "beta_v": 2,
    "beta_e": 2,
    "lamda": 0.5,
    "sort_by_amr": false,
    "relation_mask_self": true,
    "relation_directional": false,
    "symmetric_relations": [],
    "use_graph_encoder": true,

    "attention_layer_num": 4,
    "num_attention_heads": 4,
    "emb_dropout": 0.05,
    "repr_dropout": 0.05,
    "intermediate_dim": 3072,
    "similarity_fc": "bilinear",
    "amr_path_reduce": "mean",
    "use_trigger_type": true,
    "use_entity_type": true,
    "use_pos_emb": true,
    "use_bce_loss": true,
    "use_marginal_loss": false,
    "use_valid_pattern": false,


    "train_file": "dataset/ACE05/bert_large_cased/amr_ie/train.oneie.json",
    "dev_file": "dataset/ACE05/bert_large_cased/amr_ie/dev.oneie.json",
    "test_file": "dataset/ACE05/bert_large_cased/amr_ie/test.oneie.json",
    "train_amr":"dataset/ACE05/bert_large_cased/amr_ie/train_amrs.pkl",
    "dev_amr":"dataset/ACE05/bert_large_cased/amr_ie/dev_amrs.pkl",
    "test_amr":"dataset/ACE05/bert_large_cased/amr_ie/test_amrs.pkl",
    "log_path": "./experiment/",
    "valid_pattern_path": "./resource/valid_patterns",
    "ignore_title": true,
    "ignore_first_header": false,

  
    "accumulate_step": 1,
    "batch_size": 10,
    "eval_batch_size": 16,
    "max_epoch": 200,
    "learning_rate": 1e-4,
    "bert_learning_rate": 1e-5,
    "weight_decay": 1e-4,
    "bert_weight_decay": 1e-5,
    "warmup_epoch": 5,
    "grad_clipping": 5.0,
  
    "use_gpu": true,
    "gpu_device": 3,
    "if_local": 0
  }
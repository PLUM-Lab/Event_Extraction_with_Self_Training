{
    "bert_model_name": "roberta_large",
    "bert_cache_dir": "bert_cache",
    "multi_piece_strategy": "average",
    "bert_dropout": 0.5,
    "use_extra_bert": true,
    "extra_bert": -3,
  
    "use_global_features": true,
    "global_features": ["role_role", "event_role_num", "role_entity", "multi_role", "relation_entity", "relation_role_role", "relation_relation", "multi_event"],
    "global_warmup": 0,
  
    "linear_dropout": 0.4,
    "linear_bias": true,
    "entity_hidden_num": 150,
    "mention_hidden_num": 150,
    "event_hidden_num": 600,
    "relation_hidden_num": 150,
    "role_hidden_num": 600,
    "use_entity_type": true,
    "beam_size": 1,
    "beta_v": 2,
    "beta_e": 2,
    "relation_mask_self": true,
    "relation_directional": true,
    "symmetric_relations": ["PER-SOC"],
  
    "train_file": "YOUR_PROJECT_PATH/dataset/ACE05+/roberta_large/train.oneie.json",
    "dev_file": "YOUR_PROJECT_PATH/dataset/ACE05+/roberta_large/dev.oneie.json",
    "test_file": "YOUR_PROJECT_PATH/dataset/ACE05+/roberta_large/test.oneie.json",
    "log_path": "experiment",
    "valid_pattern_path": "resource/valid_patterns",
    "ignore_title": false,
    "ignore_first_header": false,


    "load_model_path": "YOUR_PROJECT_PATH/experiment/ie/ACE+/roberta_exp2/best.role.mdl",
    "score_model_path": "experiment/seq_score/ACE+/roberta_exp2/best.role.mdl",
    "aux_train_file": "YOUR_PROJECT_PATH/dataset/nyt/ACE/2004.jsonl.amr",
    "order_file": "",
    "min_amr_length": -1,
    "test_beam_size": 10,
    "aux2train_ratio": 1,
    "mix_ratio": 1.0,
    "feedback": true,
    "further_train": false,
    "use_trigger_score": false,
    "optimizer": "sgd",
    "use_heuristic": false,
    "trigger_weight": 0.0,
    "ordered_aux": false,
    "score_threshold": 0.9,
  
    "accumulate_step": 1,
    "batch_size": 10,
    "aux_batch_size": 2,
    "eval_batch_size": 16,
    "max_epoch": 30,
    "learning_rate": 0.001,
    "bert_learning_rate": 0.0001,
    "weight_decay": 5.00E-05,
    "bert_weight_decay": 1.00E-05,
    "warmup_epoch": 5,
    "grad_clipping": 5.0,
  
    "use_gpu": true,
    "gpu_device": 0,
    "if_local": 0
  }

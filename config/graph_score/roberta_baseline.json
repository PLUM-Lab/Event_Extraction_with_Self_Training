{
    "bert_model_name": "roberta-large",
    "bert_cache_dir": "./",
    "multi_piece_strategy": "average",
    "bert_dropout": 0.5,
    "use_extra_bert": false,
    "extra_bert": -3,
  
    "use_global_features": true,
    "global_features": [],
    "global_warmup": 0,
  
    "linear_dropout": 0.4,
    "linear_bias": true,
    "entity_hidden_num": 150,
    "mention_hidden_num": 150,
    "event_hidden_num": 600,
    "relation_hidden_num": 150,
    "role_hidden_num": 600,
    "edge_type_dim": 256,
    "gnn_layers": 2,
    "beam_size": 10,
    "beta_v": 2,
    "beta_e": 2,
    "lamda": 0.5,
    "sort_by_amr": false,
    "relation_mask_self": true,
    "relation_directional": false,
    "symmetric_relations": [],
    "use_graph_encoder": true,


    "use_trigger_type": true,
    "use_bce_loss": true,
    "use_marginal_loss": true,
    "use_valid_pattern": false,
    "model_type": "graph_score",
    "loss_ratio": 0.1,


    "train_file": "dataset/ACE05-E/roberta_large/train.oneie.json",
    "dev_file": "dataset/ACE05-E/roberta_large/dev.oneie.json",
    "test_file": "dataset/ACE05-E/roberta_large/test.oneie.json",
    "train_amr":"dataset/ACE05-E/roberta_large/train_amrs.pkl",
    "dev_amr":"dataset/ACE05-E/roberta_large/dev_amrs.pkl",
    "test_amr":"dataset/ACE05-E/roberta_large/test_amrs.pkl",
    "log_path": "./experiment/",
    "valid_pattern_path": "./resource/valid_patterns",
    "ignore_title": false,
    "ignore_first_header": false,
    "ie_model_path": "experiment/ie/ACE/new_exp1/best.role.mdl",

  
    "accumulate_step": 1,
    "batch_size": 10,
    "eval_batch_size": 16,
    "max_epoch": 80,
    "learning_rate": 1e-4,
    "bert_learning_rate": 1e-5,
    "weight_decay": 1e-4,
    "bert_weight_decay": 1e-5,
    "warmup_epoch": 5,
    "grad_clipping": 5.0,
  
    "use_gpu": true,
    "gpu_device": 3,
    "if_local": 0
  }
{
    "bert_model_name": "roberta_large",
    "bert_cache_dir": "bert_cache",
    "multi_piece_strategy": "average",
    "bert_dropout": 0.5,
    "use_extra_bert": true,
    "extra_bert": -3,
  
    "use_global_features": true,
    "global_features": [],
    "global_warmup": 0,
  
    "linear_dropout": 0.4,
    "linear_bias": true,
    "entity_hidden_num": 150,
    "mention_hidden_num": 150,
    "event_hidden_num": 600,
    "relation_hidden_num": 150,
    "role_hidden_num": 600,
    "use_entity_type": true,
    "beam_size": 1,
    "beta_v": 2,
    "beta_e": 2,
    "relation_mask_self": true,
    "relation_directional": false,
    "symmetric_relations": ["PER-SOC"],
  
    "train_file": "YOUR_AMR_IE_PATH/dataset/ACE05/roberta_large/train.oneie.json",
    "dev_file": "YOUR_AMR_IE_PATH/dataset/ACE05/roberta_large/dev.oneie.json",
    "test_file": "YOUR_AMR_IE_PATH/dataset/ACE05/roberta_large/test.oneie.json",
    "log_path": "experiment",
    "valid_pattern_path": "resource/valid_patterns",
    "ignore_title": true,
    "ignore_first_header": false,


    "load_model_path": "experiment/ie/roberta_oneie/best.role.mdl",
    "score_model_path": "experiment/graph_score/roberta_trigger-type-noise-0.1_entity-type-noise-0.05/best.role.mdl",
    "aux_train_file": "YOUR_PROJECT_PATH/dataset/aligned_amr3.0/aux_amr3.0.jsonl",
    "train_amr":"YOUR_AMR_IE_PATH/dataset/ACE05/roberta_large/train_amrs.pkl",
    "dev_amr":"YOUR_AMR_IE_PATH/dataset/ACE05/roberta_large/dev_amrs.pkl",
    "test_amr":"YOUR_AMR_IE_PATH/dataset/ACE05/roberta_large/test_amrs.pkl",
    "min_amr_length": 15,
    "test_beam_size": 1,
    "aux2train_ratio": 1,
    "mix_ratio": 1.0,
    "feedback": true,
    "further_train": false,
    "optimizer": "sgd",

  
    "accumulate_step": 1,
    "batch_size": 16,
    "eval_batch_size": 16,
    "max_epoch": 40,
    "learning_rate": 0.005,
    "bert_learning_rate": 1e-5,
    "weight_decay": 5e-5,
    "bert_weight_decay": 1e-5,
    "warmup_epoch": 5,
    "grad_clipping": 5.0,
  
    "use_gpu": true,
    "gpu_device": 0
  }
